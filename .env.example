# Create a bot in @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=

# Where vacancy cards are published: a channel/group or your private chat with the bot.
# Examples: @your_channel_username or -1001234567890
# To receive vacancies in the bot's private chat instead of a channel,
# put your numeric Telegram user ID here (ask the bot with /whoami).
TARGET_CHAT_ID=

# Optional comma-separated Telegram user IDs allowed to publish via this bot.
OPERATOR_USER_IDS=

# normalize = parse forwarded/user messages into the IT Job Board card
# copy = copy the original incoming message to TARGET_CHAT_ID
FORWARDED_MODE=normalize

# Form handling is limited to explicitly approved domains.
APPLICATION_ALLOWED_DOMAINS=

# Optional GitHub Actions application queue. Keep disabled until every required
# value below is configured as a GitHub Actions secret. The scheduled runner
# downloads the resume from Telegram by file_id and deletes the temporary copy
# when the job ends. There are currently no source-specific auto-application
# adapters; unsupported forms stop with a manual-action notification.
APPLICATION_QUEUE_ENABLED=false
APPLICATION_AUTO_SUBMIT=false
APPLICATION_QUEUE_PROFILE_FULL_NAME=
APPLICATION_QUEUE_PROFILE_EMAIL=
APPLICATION_QUEUE_PROFILE_PHONE=
APPLICATION_QUEUE_PROFILE_PERSONAL_URL=
APPLICATION_QUEUE_PROFILE_COVER_LETTER=
# Optional legacy/bootstrap fallback. Normally upload the document to the bot
# with the /queue_resume caption and let GitHub Actions remember its file_id.
APPLICATION_QUEUE_RESUME_FILE_ID=
APPLICATION_QUEUE_RESUME_FILE_NAME=resume.pdf

# Global vacancy filter: which specialty and grade should be parsed.
# Specialty: frontend, backend, fullstack, frontend_fullstack, mobile, qa, devops, data, design
# Grade: intern, junior, middle, senior, lead
# Can be changed at runtime with /filters (operators only). Defaults keep junior frontend/fullstack.
VACANCY_DEFAULT_SPECIALTY=frontend_fullstack
VACANCY_DEFAULT_GRADE=junior

# Optional scheduled parsing into the bot's private chat. The local bot pushes
# the active /filters selection to GitHub Actions repository variables so the
# scheduled runner follows it. No token is required when the `gh` CLI is already
# installed and authenticated on this machine: the bot delegates to
# `gh variable set` and auto-detects the repository from `git remote origin`.
# A fine-grained PAT (Actions > Variables read/write) is only an alternative
# for machines without a usable `gh` session. Keep any token only locally:
# example: GITHUB_REPOSITORY=BoomCoderchik/tg-vacancy-bot
#GITHUB_FILTER_SYNC_TOKEN=
#GITHUB_REPOSITORY=

# Optional SQLite database path for deduplication.
DATABASE_PATH=data/vacancies.sqlite3

# Source polling interval while `tg-vacancy-bot run` is active.
# Set to 0 to disable background polling and only handle forwarded messages.
SOURCE_POLL_INTERVAL_SECONDS=60
SOURCE_MAX_PUBLISH_PER_POLL=20
SOURCE_MAX_AGE_HOURS=48

# Optional keyed LinkedIn hiring-post discovery (SerpApi). The free scraper and
# headless adapters below do not need any API key. The adapters read only
# publicly indexed posts; account login, CAPTCHA bypass, and automatic
# application are not supported.
ENABLE_LINKEDIN_POST_SEARCH=false
SERPAPI_API_KEY=
LINKEDIN_POST_SEARCH_QUERY=(site:linkedin.com/posts OR site:linkedin.com/feed/update) ("we are hiring" OR hiring OR "ищем" OR "ищет") (frontend OR backend OR developer OR engineer OR react OR python OR разработчик OR инженер)
LINKEDIN_POST_SEARCH_RESULTS_WANTED=10
ENABLE_LINKEDIN_POST_SCRAPER=false
LINKEDIN_POST_SCRAPER_QUERY=(site:linkedin.com/posts OR site:linkedin.com/feed/update) ("we are hiring" OR hiring OR "ищем" OR "ищет") (frontend OR backend OR developer OR engineer OR react OR python OR разработчик OR инженер)
LINKEDIN_POST_SCRAPER_SEARCH_PROVIDERS=bing_rss,duckduckgo,bing,duckduckgo_lite,mojeek
LINKEDIN_POST_SCRAPER_RESULTS_WANTED=100
# Apify's public HarvestAPI actor searches post bodies without a LinkedIn login.
# Review the actor's terms and pricing before enabling this paid external source.
ENABLE_LINKEDIN_POST_APIFY=false
APIFY_API_TOKEN=
LINKEDIN_POST_APIFY_ACTOR=harvestapi/linkedin-post-search
LINKEDIN_POST_APIFY_SEARCH_QUERIES=
LINKEDIN_POST_APIFY_POSTED_LIMIT=24h
LINKEDIN_POST_APIFY_MAX_POSTS=25
LINKEDIN_POST_APIFY_TIMEOUT_SECONDS=240
ENABLE_LINKEDIN_POST_HEADLESS=false
LINKEDIN_HEADLESS_ACCESS_AUTHORIZED=false
LINKEDIN_HEADLESS_PERMISSION_REFERENCE=
LINKEDIN_POST_HEADLESS_QUERY=
LINKEDIN_POST_HEADLESS_RESULTS_WANTED=10
LINKEDIN_HEADLESS_DISCOVERY_PAGES=3
LINKEDIN_POST_SEARCH_INTENTS_PER_CYCLE=6
LINKEDIN_POST_HEADLESS_TIMEOUT_SECONDS=20
LINKEDIN_POST_MAX_AGE_HOURS=240
# LinkedIn public guest post pages: discovers post URLs through the free public
# search providers, then reads each post's own linkedin.com page through plain
# HTTP without an account, API key, or browser.
ENABLE_LINKEDIN_POST_GUEST=false
LINKEDIN_POST_GUEST_QUERY=
LINKEDIN_POST_GUEST_RESULTS_WANTED=30

# Russia-wide vacancy sources: internet search across the whole open web
# prioritizing real Russian job domains (hh.ru, career.habr.com, superjob.ru,
# getmatch.ru, vc.ru, etc.) and public Telegram channels with vacancies.
# The active /filters selection (specialties + grades) drives the search
# queries when RUSSIA_SEARCH_QUERY is empty.
ENABLE_RUSSIA_SEARCH=false
RUSSIA_SEARCH_RESULTS_WANTED=50
RUSSIA_SEARCH_QUERY=
RUSSIA_SEARCH_PROVIDERS=bing_rss,duckduckgo,bing,duckduckgo_lite,mojeek

ENABLE_RUSSIA_TELEGRAM=false
# Comma-separated Telegram channel usernames (without @), e.g. itvacancy,superjob_it
RUSSIA_TELEGRAM_CHANNELS=itvacancy,it_vacancy,vakansii_it,superjob_it,itjobs_ru,vakansii,remote_it,webdev_jobs,rabota_russia,it_vacancy_ru,frontend_vacancy
RUSSIA_TELEGRAM_MAX_POSTS_PER_CHANNEL=20

# HeadHunter official public RSS search feed: no API key or account required.
# The active /filters selection drives the queries when HHRU_RSS_QUERY is empty;
# a manual ||-separated query always wins. Uses plain web-browser headers.
ENABLE_HHRU_RSS=false
HHRU_RSS_QUERY=
HHRU_RSS_RESULTS_WANTED=40

# Source polling always localizes descriptions. This switch only controls manual-message localization.
LOCALIZE_DESCRIPTIONS=false
LOCALIZATION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_FALLBACK_MODELS=
OPENAI_BASE_URL=

# OpenRouter free-mode example (availability and limits can change):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENAI_FALLBACK_MODELS=openai/gpt-oss-20b:free,openrouter/free
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b
